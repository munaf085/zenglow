# =============================================================
# ZENGLOW ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets.
# =============================================================

# --- Database ---
DATABASE_URL=postgresql://zenglow:zenglow_dev@localhost:5432/zenglow_db
DATABASE_TEST_URL=postgresql://zenglow:zenglow_dev@localhost:5432/zenglow_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Backend ---
BACKEND_PORT=8000
BACKEND_WORKERS=4
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SECRET_KEY=change-this-secret-key-in-production

# --- Storage (S3-compatible) ---
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=zenglow-media
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=./uploads

# --- Payments ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@zenglow.com
EMAIL_FROM_NAME=Zenglow

# --- SMS ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# --- WhatsApp ---
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id

# --- Push Notifications (Firebase) ---
PUSH_PROVIDER=console
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=zenglow-api

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
NEXT_PUBLIC_SENTRY_DSN=

# --- Customer Web (port 3000) ---
CUSTOMER_WEB_PORT=3000

# --- Business Web (port 3001) ---
BUSINESS_WEB_PORT=3001

# --- Admin Web (port 3002) ---
ADMIN_WEB_PORT=3002
